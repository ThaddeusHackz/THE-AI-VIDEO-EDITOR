{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "render_qa report",
  "type": "object",
  "required": [
    "video",
    "verdict",
    "checks"
  ],
  "properties": {
    "video": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check",
          "status",
          "detail"
        ],
        "properties": {
          "check": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "WARN"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}